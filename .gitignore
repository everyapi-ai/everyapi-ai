# Build outputs from `make cli` / `make cli-release`. Kept local to
# clients/cli/ so the mirror inherits this rule when cli-release.yml
# subtree-copies the directory.
/bin/
/dist/

# Menubar .app bundle output from cmd/menubar/build-macos.sh.
cmd/menubar/dist/
# `go build ./cmd/menubar` without -o drops the binary here.
/menubar
/menubar.exe
